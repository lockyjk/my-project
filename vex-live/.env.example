# Copy this file to .env and fill it in. Never commit .env.

# Your TikTok username (the one that goes live), without the @
TIKTOK_USERNAME=

# Claude API key from https://platform.claude.com (Settings -> API keys)
ANTHROPIC_API_KEY=
# Optional: a faster/cheaper model, e.g. claude-haiku-5-5
CLAUDE_MODEL=claude-opus-5-5

# ElevenLabs key and one voice per character (https://elevenlabs.io -> Voices -> copy Voice ID)
# Leave blank to run with subtitles only (no voice).
ELEVENLABS_API_KEY=
VEX_VOICE_ID=
PIP_VOICE_ID=

# Optional: Euler Stream key for the TikTok connection (higher rate limits)
EULER_API_KEY=

# Overlay port for the OBS browser source
PORT=5077
# Seconds of quiet chat before Vex and Pip start chatting on their own
IDLE_SECONDS=25
