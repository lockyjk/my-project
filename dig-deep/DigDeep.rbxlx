	})
	label({ parent = body, text = "Playing with a friend gives +10% coins!", size = 15, color = Color3.fromRGB(255, 240, 150), sz = UDim2.new(1, 0, 0, 20), pos = UDim2.new(0, 0, 0, 320) })
	local data = { list = {}, bonus = false, resets = 0 }
	local function refresh()
		local raw = player:GetAttribute("Quests")
		if type(raw) == "string" then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(decoded) == "table" then
				data = decoded
			end
		end
		local claimable, allClaimed = false, #data.list > 0
		for i, row in rows do
			local q = data.list[i]
			row.text.Parent.Visible = q ~= nil
			if q then
				row.text.Text = q.text
				row.fill.Size = UDim2.fromScale(math.clamp(q.progress / math.max(1, q.goal), 0, 1), 1)
				row.barText.Text = `{q.progress} / {q.goal}`
				local done = q.progress >= q.goal
				if q.claimed then
					row.claimText.Text = "✔ DONE"
					row.claimGrad.Color = bevel(Color3.fromRGB(200, 200, 210), Color3.fromRGB(150, 150, 165))
				elseif done then
					row.claimText.Text = "CLAIM!"
					row.claimGrad.Color = bevel(Color3.fromRGB(120, 235, 120), Color3.fromRGB(40, 170, 70))
					claimable = true
				else
					row.claimText.Text = `💰 {CFG.questRewardMinutes} min`
					row.claimGrad.Color = bevel(Color3.fromRGB(255, 226, 92), Color3.fromRGB(255, 150, 30))
				end
				allClaimed = allClaimed and q.claimed
			end
		end
		if data.bonus then
			bonusText.Text = "✔ Bonus claimed. New quests tomorrow!"
			bonusGrad.Color = bevel(Color3.fromRGB(200, 200, 210), Color3.fromRGB(150, 150, 165))
		elseif allClaimed then
			bonusText.Text = "🎁 CLAIM BONUS: free egg + Luck potion!"
			bonusGrad.Color = bevel(Color3.fromRGB(255, 150, 200), Color3.fromRGB(230, 70, 140))
			claimable = true
		else
			bonusText.Text = "🎁 Finish all 3 for a free egg!"
			bonusGrad.Color = bevel(Color3.fromRGB(230, 220, 240), Color3.fromRGB(180, 170, 200))
		end
		stackButtons.Quests.Badge.Visible = claimable
	end
	player:GetAttributeChangedSignal("Quests"):Connect(refresh)
	refresh()
	windows.Quests_reset = function()
		if data.resets and data.resets > 0 then
			resetLabel.Text = "New quests in " .. clock(data.resets - workspace:GetServerTimeNow())
		end
	end
end

-- WELCOME BACK popup (offline earnings + daily chest reminder) -----------------------
Remotes.Welcome.OnClientEvent:Connect(function(amount, minutes, dailyReady, streak, strengthAway)
	local panel = create("Frame", {
		Name = "WelcomePopup",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.45),
		Size = UDim2.fromOffset(440, if amount > 0 then 270 else 190),
		BackgroundColor3 = WHITE,
		ZIndex = 30,
		Parent = overlayGui,
	}, { corner(UDim.new(0, 26)), stroke(5, INK) })
	gradient(panel, Color3.fromRGB(255, 252, 244), Color3.fromRGB(236, 226, 210))
	local sc = create("UIScale", { Scale = 0.4, Parent = panel })
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	label({ parent = panel, text = "👋 WELCOME BACK!", size = 34, color = Color3.fromRGB(255, 190, 60), sz = UDim2.new(1, 0, 0, 44), pos = UDim2.fromOffset(0, 14), z = 31 })
	local y = 62
	if amount > 0 then
		local hours = math.floor(minutes / 60)
		label({ parent = panel, text = `You kept digging and training for {if hours > 0 then hours .. "h " else ""}{minutes % 60}m`, size = 18, color = INK, outline = false, sz = UDim2.new(1, 0, 0, 24), pos = UDim2.fromOffset(0, y), z = 31 })
		label({ parent = panel, text = "+ 💰 " .. fmt(amount) .. (if (strengthAway or 0) > 0 then "   + 💪 " .. fmt(strengthAway) else ""), size = 36, color = GOLD, sz = UDim2.new(1, 0, 0, 50), pos = UDim2.fromOffset(0, y + 28), z = 31 })
		y += 86
	end
	if dailyReady then
		label({ parent = panel, text = if (streak or 0) > 0 then `🎁 Daily chest ready! Keep your 🔥{streak}-day streak` else "🎁 Your daily chest is ready!", size = 17, color = Color3.fromRGB(200, 90, 40), outline = false, sz = UDim2.new(1, 0, 0, 24), pos = UDim2.fromOffset(0, y), z = 31 })
	end
	local btn = cartoonButton(panel, {
		sz = UDim2.fromOffset(220, 54),
		anchor = Vector2.new(0.5, 1),
		pos = UDim2.new(0.5, 0, 1, -16),
		top = Color3.fromRGB(120, 235, 120),
		bottom = Color3.fromRGB(40, 170, 70),
		text = if amount > 0 then "COLLECT!" else "LET'S DIG!",
		textSize = 24,
		z = 31,
		onClick = function()
			if amount > 0 then
				Remotes.Action:FireServer("CollectOffline")
				confetti(40)
			end
			local t = tween(sc, 0.2, { Scale = 0 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			t.Completed:Connect(function()
				panel:Destroy()
			end)
		end,
	})
	btn.ZIndex = 31
	playSound("Treasure", 1.1)
end)

-- SETTINGS window ---------------------------------------------------------------
do
	local _, body = makeWindow("Settings", "⚙️ SETTINGS", Color3.fromRGB(220, 224, 235), Color3.fromRGB(140, 146, 165))
	local list = create("ScrollingFrame", {
		Size = UDim2.fromScale(1, 1),
		BackgroundTransparency = 1,
		BorderSizePixel = 0,
		ScrollBarThickness = 8,
		ScrollBarImageColor3 = INK,
		AutomaticCanvasSize = Enum.AutomaticSize.Y,
		CanvasSize = UDim2.new(),
		Parent = body,
	}, { create("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }), create("UIPadding", { PaddingRight = UDim.new(0, 12) }) })
	local saveToken = 0
	local function save()
		saveToken += 1
		local token = saveToken
		task.delay(0.8, function()
			if token == saveToken then
				Remotes.Action:FireServer("Settings", settings)
			end
		end)
	end
	local refreshers = {}
	local function row(order, icon, text, key, volumeKey)
		local r = create("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 62), BackgroundColor3 = WHITE, Parent = list }, { corner(UDim.new(0, 16)), stroke(3, INK) })
		gradient(r, WHITE, Color3.fromRGB(232, 236, 248))
		label({ parent = r, text = icon, size = 30, outline = false, sz = UDim2.fromOffset(50, 62), pos = UDim2.fromOffset(8, 0) })
		label({ parent = r, text = text, size = 21, color = INK, outline = false, sz = UDim2.new(0.4, 0, 1, 0), pos = UDim2.fromOffset(62, 0), alignX = Enum.TextXAlignment.Left })
		local toggle, toggleGrad = cartoonButton(r, { sz = UDim2.fromOffset(92, 42), anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -12, 0.5, 0), top = WHITE, bottom = WHITE, textSize = 20 })
		local toggleText = label({ parent = toggle, text = "", size = 20, z = 2 })
		local volText
		if volumeKey then
			local function step(delta)
				settings[volumeKey] = math.clamp(math.floor((settings[volumeKey] + delta) * 10 + 0.5) / 10, 0, 1)
				applySoundSettings()
				save()
				for _, f in refreshers do
					f()
				end
			end
			cartoonButton(r, { sz = UDim2.fromOffset(42, 42), anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -250, 0.5, 0), top = Color3.fromRGB(255, 200, 90), bottom = Color3.fromRGB(230, 140, 30), text = "−", textSize = 26, onClick = function()
				step(-0.1)
			end })
			volText = label({ parent = r, text = "", size = 20, color = INK, outline = false, sz = UDim2.fromOffset(70, 42), anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -174, 0.5, 0) })
			cartoonButton(r, { sz = UDim2.fromOffset(42, 42), anchor = Vector2.new(1, 0.5), pos = UDim2.new(1, -124, 0.5, 0), top = Color3.fromRGB(255, 200, 90), bottom = Color3.fromRGB(230, 140, 30), text = "+", textSize = 26, onClick = function()
				step(0.1)
			end })
		end
		local function refresh()
			local on = settings[key]
			toggleText.Text = if on then "ON" else "OFF"
			toggleGrad.Color = if on
				then bevel(Color3.fromRGB(120, 235, 120), Color3.fromRGB(40, 170, 70))
				else bevel(Color3.fromRGB(255, 120, 110), Color3.fromRGB(220, 50, 50))
			if volText then
				volText.Text = `{math.floor(settings[volumeKey] * 100 + 0.5)}%`
			end
		end
		toggle.Activated:Connect(function()
			settings[key] = not settings[key]
			applySoundSettings()
			if key == "otherPets" then
				for _, plr in Players:GetPlayers() do
					rebuildPets(plr)
				end
			end
			refresh()
			save()
			playSound("Click", 1)
		end)
		table.insert(refreshers, refresh)
		refresh()
	end
	row(1, "🎵", "Music", "music", "musicVol")
	row(2, "🔊", "Sound effects", "sfx", "sfxVol")
	row(3, "🌲", "Ambience", "ambience")
	row(4, "🐾", "Other players' pets", "otherPets")
	row(5, "📳", "Screen shake", "shake")
	-- load saved settings from the server
	local function loadSaved()
		local raw = player:GetAttribute("Settings")
		if type(raw) == "string" then
			local ok, data = pcall(function()
				return HttpService:JSONDecode(raw)
			end)
			if ok and type(data) == "table" then
				for k, v in data do
					if settings[k] ~= nil and typeof(v) == typeof(settings[k]) then
						settings[k] = v
					end
				end
			end
		end
		applySoundSettings()
		for _, f in refreshers do
			f()
		end
		for _, plr in Players:GetPlayers() do
			if plr ~= player then
				rebuildPets(plr)
			end
		end
	end
	player:GetAttributeChangedSignal("Settings"):Once(loadSaved)
	loadSaved()
end

-- +1 STRENGTH EVERY CLICK -------------------------------------------------------------
-- Strength counter, "+1 💪" popups at your cursor, milestone rewards, Rebirth and free gifts.
;(function()
	local STRENGTH_RED = Color3.fromRGB(255, 96, 70)

	-- Strength pill under the level bar
	local pill = create("Frame", {
		Name = "Strength",
		Position = UDim2.new(0, 14, 0, 150),
		Size = UDim2.fromOffset(0, 42),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = WHITE,
		Parent = gui,
	}, {
		corner(),
		stroke(4, Color3.fromRGB(120, 24, 16)),
		create("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 16) }),
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, VerticalAlignment = Enum.VerticalAlignment.Center, Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	create("UIGradient", { Color = bevel(Color3.fromRGB(255, 130, 90), Color3.fromRGB(226, 50, 40)), Rotation = 90, Parent = pill })
	local pillScale = create("UIScale", { Parent = pill })
	label({ parent = pill, text = "💪", size = 28, outline = false, order = 1, sz = UDim2.fromOffset(32, 36) })
	local strengthText = label({ parent = pill, text = "0", size = 30, order = 2, sz = UDim2.fromOffset(0, 36) })
	strengthText.AutomaticSize = Enum.AutomaticSize.X
	local multText = label({ parent = pill, text = "", size = 17, color = Color3.fromRGB(255, 240, 150), order = 3, sz = UDim2.fromOffset(0, 36) })
	multText.AutomaticSize = Enum.AutomaticSize.X

	local shown = create("NumberValue", { Value = attr("Strength", 0) })
	strengthText.Text = fmt(shown.Value)
	shown.Changed:Connect(function(v)
		strengthText.Text = fmt(math.floor(v))
	end)
	local function refreshMult()
		multText.Text = `+{attr("StrMult", 1)}/click`
	end
	player:GetAttributeChangedSignal("StrMult"):Connect(refreshMult)
	refreshMult()

	-- "+N 💪" pops up where you clicked (or over the counter when a rock trains you)
	local combo, lastGain = 0, 0
	local function popAt(screenPos, text)
		local l = label({
			parent = overlayGui,
			text = text,
			size = 30,
			color = Color3.fromRGB(255, 120, 90),
			sz = UDim2.fromOffset(160, 36),
			anchor = Vector2.new(0.5, 0.5),
			pos = UDim2.fromOffset(screenPos.X + math.random(-18, 18), screenPos.Y - 20),
			z = 45,
		})
		l.Rotation = math.random(-12, 12)
		local sc = create("UIScale", { Scale = 0.4, Parent = l })
		tween(sc, 0.18, { Scale = 1.15 }, Enum.EasingStyle.Back)
		tween(l, 0.8, { Position = l.Position - UDim2.fromOffset(0, 70), TextTransparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		local st = l:FindFirstChildOfClass("UIStroke")
		if st then
			tween(st, 0.8, { Transparency = 1 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		end
		Debris:AddItem(l, 0.85)
	end
	local last = attr("Strength", 0)
	player:GetAttributeChangedSignal("Strength"):Connect(function()
		local now = attr("Strength", 0)
		local gain = now - last
		last = now
		if gain <= 0 then
			shown.Value = now -- rebirth reset
			return
		end
		tween(shown, 0.25, { Value = now })
		pulse(pillScale, 1.1)
		local t = os.clock()
		combo = if t - lastGain < 1.2 then math.min(combo + 1, 24) else 0
		lastGain = t
		local where
		if t - trainFx.at < 0.6 and UserInputService.MouseEnabled then
			where = UserInputService:GetMouseLocation()
		elseif t - trainFx.at < 0.6 and touchPos then
			where = touchPos
		else
			-- a training rock (or gift) gave it: pop over the counter and swing for the player
			local pos = pill.AbsolutePosition + pill.AbsoluteSize * Vector2.new(0.8, 0.5)
			where = Vector2.new(pos.X + 60, pos.Y)
			if attr("Training", 0) ~= 0 then
				playSwing()
				playSound("Swing", 0.9 + math.random() * 0.2)
			end
		end
		popAt(where, "+" .. fmt(gain) .. " 💪")
		-- a soft pop that climbs in pitch while you keep clicking
		playSound("Pop", 0.8 + combo * 0.03)
	end)

	-- Milestones and rebirths: a big burst in the middle of the screen
	local function celebrate(title, sub, color)
		local big = label({ parent = overlayGui, text = title, size = 60, color = color, sz = UDim2.fromOffset(700, 76), pos = UDim2.fromScale(0.5, 0.3), anchor = Vector2.new(0.5, 0.5), z = 40 })
		local small = label({ parent = overlayGui, text = sub, size = 28, color = GOLD, sz = UDim2.fromOffset(700, 36), pos = UDim2.fromScale(0.5, 0.37), anchor = Vector2.new(0.5, 0.5), z = 40 })
		local sc = create("UIScale", { Scale = 0.3, Parent = big })
		tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
		task.delay(2, function()
			tween(sc, 0.25, { Scale = 0 })
			tween(small, 0.25, { TextTransparency = 1 })
			task.wait(0.3)
			big:Destroy()
			small:Destroy()
		end)
	end
	Remotes.Milestone.OnClientEvent:Connect(function(value, reward)
		if value == "Rebirth" then
			celebrate(`🔁 REBIRTH {reward}!`, `Now +{1 + reward * CFG.rebirthStrength} 💪 every click · +{math.floor(reward * CFG.rebirthCash * 100 + 0.5)}% cash`, Color3.fromRGB(124, 240, 255))
			confetti(90)
			playSound("LevelUp", 0.9)
			return
		end
		celebrate(`💪 {fmt(value)} STRENGTH!`, "+ 💰 " .. fmt(reward), STRENGTH_RED)
		confetti(35)
		playSound("Buy", 1.1)
	end)

	-- REBIRTH window ------------------------------------------------------------------
	local _, rbody = makeWindow("Rebirth", "🔁 REBIRTH", Color3.fromRGB(130, 236, 255), Color3.fromRGB(40, 150, 230))
	local info = label({ parent = rbody, text = "", size = 22, wrap = true, sz = UDim2.new(1, 0, 0, 84), pos = UDim2.fromOffset(0, 4) })
	local cards = create("Frame", { Size = UDim2.new(1, 0, 0, 120), Position = UDim2.fromOffset(0, 96), BackgroundTransparency = 1, Parent = rbody }, {
		create("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 18) }),
	})
	local function statCard(order, title, top, bottom)
		local c = create("Frame", { LayoutOrder = order, Size = UDim2.fromOffset(220, 116), BackgroundColor3 = WHITE, Parent = cards }, { corner(UDim.new(0, 14)), stroke(4, INK) })
		gradient(c, top, bottom)
		decorate(c, 6)
		label({ parent = c, text = title, size = 20, sz = UDim2.new(1, 0, 0, 30), pos = UDim2.fromOffset(0, 8), z = 2 })
		return label({ parent = c, text = "", size = 26, wrap = true, sz = UDim2.new(1, -12, 0, 66), pos = UDim2.fromOffset(6, 40), z = 2 })
	end
	local nowText = statCard(1, "NOW", Color3.fromRGB(150, 160, 190), Color3.fromRGB(90, 100, 130))
	label({ parent = cards, text = "➜", size = 48, order = 2, sz = UDim2.fromOffset(40, 116) })
	local nextText = statCard(3, "AFTER REBIRTH", Color3.fromRGB(120, 240, 150), Color3.fromRGB(30, 170, 80))
	local barBack = create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 232), Size = UDim2.new(0.9, 0, 0, 34), BackgroundColor3 = Color3.fromRGB(40, 30, 70), Parent = rbody }, { corner(), stroke(4, INK) })
	local barFill = create("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = WHITE, Parent = barBack }, { corner() })
	gradient(barFill, Color3.fromRGB(255, 140, 100), Color3.fromRGB(230, 50, 40))
	local barText = label({ parent = barBack, text = "", size = 20, z = 2 })
	local rebirthButton, rebirthGrad = cartoonButton(rbody, {
		sz = UDim2.fromOffset(300, 64),
		anchor = Vector2.new(0.5, 0),
		pos = UDim2.new(0.5, 0, 0, 284),
		top = Color3.fromRGB(130, 236, 255),
		bottom = Color3.fromRGB(40, 150, 230),
		text = "🔁 REBIRTH",
		textSize = 32,
		onClick = function()
			Remotes.Action:FireServer("Rebirth")
		end,
	})
	local function refreshRebirth()
		local r, strength, need = attr("Rebirths", 0), attr("Strength", 0), attr("RebirthReq", 250)
		info.Text = `Rebirth resets your 💪 Strength, but every rebirth makes each click stronger forever. You have {r} rebirth{if r == 1 then "" else "s"}.`
		nowText.Text = `💪 +{1 + r * CFG.rebirthStrength} per click\n💰 +{math.floor(r * CFG.rebirthCash * 100 + 0.5)}% cash`
		nextText.Text = `💪 +{1 + (r + 1) * CFG.rebirthStrength} per click\n💰 +{math.floor((r + 1) * CFG.rebirthCash * 100 + 0.5)}% cash`
		local f = math.clamp(strength / math.max(1, need), 0, 1)
		barFill.Size = UDim2.fromScale(f, 1)
		barText.Text = `💪 {fmt(strength)} / {fmt(need)}`
		local ready = strength >= need
		rebirthGrad.Color = if ready then bevel(Color3.fromRGB(130, 236, 255), Color3.fromRGB(40, 150, 230)) else bevel(Color3.fromRGB(200, 204, 215), Color3.fromRGB(140, 146, 165))
		stackButtons.Rebirth.Badge.Visible = ready
		local _ = rebirthButton
	end
	stackButton(-1, "Rebirth", "🔁", "REBIRTH", Color3.fromRGB(130, 236, 255), Color3.fromRGB(40, 150, 230))
	for _, name in { "Strength", "Rebirths", "RebirthReq" } do
		player:GetAttributeChangedSignal(name):Connect(refreshRebirth)
	end
	refreshRebirth()

	-- FREE GIFTS window: a reward every few minutes, the first after 10 seconds -------------
	local _, gbody = makeWindow("Gifts", "🎁 FREE GIFTS", Color3.fromRGB(255, 140, 190), Color3.fromRGB(226, 50, 120))
	label({ parent = gbody, text = "Keep playing to unlock every gift!", size = 20, sz = UDim2.new(1, 0, 0, 26) })
	local grid = create("Frame", { Position = UDim2.fromOffset(0, 34), Size = UDim2.new(1, 0, 1, -34), BackgroundTransparency = 1, Parent = gbody }, {
		create("UIGridLayout", { CellSize = UDim2.new(0.25, -10, 0.333, -10), CellPadding = UDim2.fromOffset(10, 10), SortOrder = Enum.SortOrder.LayoutOrder }),
	})
	local GIFT_NAMES = { strengthMinutes = "Strength", coinMinutes = "Coins", potion = "Potion", egg = "Free Egg" }
	local tiles = {}
	for i, g in CFG.gifts do
		local t = create("Frame", { LayoutOrder = i, BackgroundColor3 = WHITE, Parent = grid }, { corner(UDim.new(0, 12)), stroke(3.5, INK) })
		local tgrad = create("UIGradient", { Color = bevel(Color3.fromRGB(255, 226, 92), Color3.fromRGB(255, 160, 30)), Rotation = 90, Parent = t })
		label({ parent = t, text = g.icon, size = 34, outline = false, sz = UDim2.new(1, 0, 0.45, 0), pos = UDim2.fromScale(0, 0.02), z = 2 })
		local kind = if g.strengthMinutes then "strengthMinutes" elseif g.coinMinutes then "coinMinutes" elseif g.potion then "potion" else "egg"
		label({ parent = t, text = if g.potion then (if g.potion == "Coins" then "2x Coins" else g.potion) else GIFT_NAMES[kind], size = 16, sz = UDim2.new(1, 0, 0.2, 0), pos = UDim2.fromScale(0, 0.44), z = 2 })
		local state = label({ parent = t, text = "", size = 18, sz = UDim2.new(1, -8, 0.3, 0), pos = UDim2.new(0, 4, 0.66, 0), z = 3 })
		local claim = create("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Text = "", ZIndex = 4, Parent = t })
		claim.Activated:Connect(function()
			Remotes.Action:FireServer("ClaimGift", i)
		end)
		tiles[i] = { frame = t, grad = tgrad, state = state }
	end
	stackButton(-2, "Gifts", "🎁", "GIFTS", Color3.fromRGB(255, 140, 190), Color3.fromRGB(226, 50, 120))
	local timerLabel
	for _, c in stackButtons.Gifts:GetChildren() do
		if c:IsA("TextLabel") and c.Text == "GIFTS" then
			timerLabel = c
		end
	end
	local readyBefore = {}
	local function refreshGifts()
		local start = attr("GiftStart", 0)
		local elapsed = if start > 0 then workspace:GetServerTimeNow() - start else 0
		local claimed = {}
		local ok, list = pcall(function()
			return HttpService:JSONDecode(attr("GiftsClaimed", "[]"))
		end)
		if ok and type(list) == "table" then
			for _, i in list do
				claimed[i] = true
			end
		end
		local anyReady, nextIn = false, nil
		for i, g in CFG.gifts do
			local tile = tiles[i]
			if claimed[i] then
				tile.state.Text = "✔ CLAIMED"
				tile.grad.Color = bevel(Color3.fromRGB(200, 204, 215), Color3.fromRGB(140, 146, 165))
			elseif elapsed >= g.at then
				anyReady = true
				tile.state.Text = "CLAIM!"
				tile.grad.Color = bevel(Color3.fromRGB(140, 244, 90), Color3.fromRGB(36, 176, 50))
				if not readyBefore[i] then
					readyBefore[i] = true
					toast(`🎁 Free gift ready! Tap GIFTS`, Color3.fromRGB(255, 170, 220))
					playSound("Pickup", 1.2)
					pulse(stackButtons.Gifts:FindFirstChildOfClass("UIScale"), 1.25)
				end
			else
				tile.state.Text = clock(g.at - elapsed)
				tile.grad.Color = bevel(Color3.fromRGB(255, 226, 92), Color3.fromRGB(255, 160, 30))
				nextIn = if nextIn then math.min(nextIn, g.at - elapsed) else g.at - elapsed
			end
		end
		stackButtons.Gifts.Badge.Visible = anyReady
		if timerLabel then
			timerLabel.Text = if anyReady then "CLAIM!" elseif nextIn then clock(nextIn) else "GIFTS"
		end
	end
	Remotes.Gift.OnClientEvent:Connect(function(_, text)
		celebrate("🎁 FREE GIFT!", text, Color3.fromRGB(255, 150, 210))
		confetti(50)
		playSound("Treasure", 1.1)
		refreshGifts()
	end)
	task.spawn(function()
		while true do
			refreshGifts()
			task.wait(0.5)
		end
	end)
end)()

-- HATCH animation ------------------------------------------------------------------
local hatching = false
Remotes.Hatched.OnClientEvent:Connect(function(petId, eggId)
	local P = CFG.pets[petId]
	local egg
	for _, e in CFG.eggs do
		if e.id == eggId then
			egg = e
		end
	end
	if not P or not egg or hatching then
		if P then
			toast(`🐾 {P.name} hatched!`, GOLD)
		end
		return
	end
	hatching = true
	local rc = rgb(CFG.rarityColors[P.rarity] or { 200, 200, 210 })
	local shade = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, ZIndex = 20, Parent = overlayGui })
	tween(shade, 0.25, { BackgroundTransparency = 0.35 })
	-- the real 3D egg from the pet shop, shaking in the middle of the screen
	local eggFrame = create("ViewportFrame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.48),
		Size = UDim2.fromOffset(260, 300),
		BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(190, 190, 200),
		LightColor = WHITE,
		LightDirection = Vector3.new(-0.5, -1, -0.6),
		ZIndex = 21,
		Parent = overlayGui,
	})
	local town = workspace:FindFirstChild("Town")
	local source = town and town:FindFirstChild(egg.id)
	if source and source:IsA("Model") then
		local copy = source:Clone()
		CollectionService:RemoveTag(copy, "Spin")
		copy:PivotTo(CFrame.new())
		copy.Parent = eggFrame
		local eggCam = Instance.new("Camera")
		eggCam.FieldOfView = 40
		eggCam.CFrame = CFrame.lookAt(Vector3.new(0, 0.6, -10), Vector3.new(0, 0, 0))
		eggCam.Parent = eggFrame
		eggFrame.CurrentCamera = eggCam
	end
	local sc = create("UIScale", { Scale = 0.2, Parent = eggFrame })
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	task.wait(0.5)
	for k = 1, 3 do
		local amt = 8 + k * 6
		for _ = 1, 3 do
			tween(eggFrame, 0.06, { Rotation = amt })
			task.wait(0.07)
			tween(eggFrame, 0.06, { Rotation = -amt })
			task.wait(0.07)
		end
		eggFrame.Rotation = 0
		playSound("EggCrack", 0.9 + k * 0.1)
		task.wait(0.25)
	end
	local flash = create("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = WHITE, ZIndex = 30, Parent = overlayGui })
	tween(flash, 0.5, { BackgroundTransparency = 1 })
	Debris:AddItem(flash, 0.6)
	eggFrame:Destroy()
	playSound("Treasure", if P.rarity == "Legendary" then 0.7 else 1.1)
	confetti(if P.rarity == "Legendary" then 120 else 50)
	local vp = create("ViewportFrame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.44),
		Size = UDim2.fromOffset(300, 300),
		BackgroundTransparency = 1,
		ZIndex = 23,
		Ambient = Color3.fromRGB(200, 200, 200),
		LightColor = WHITE,
		Parent = overlayGui,
	})
	local model, revealAnims = buildPet(petId)
	model.Parent = vp
	local cam = Instance.new("Camera")
	cam.FieldOfView = 40
	cam.CFrame = CFrame.lookAt(Vector3.new(0, 0.9, -6.5), Vector3.new(0, 0.3, 0))
	cam.Parent = vp
	vp.CurrentCamera = cam
	local vsc = create("UIScale", { Scale = 0.2, Parent = vp })
	tween(vsc, 0.5, { Scale = 1 }, Enum.EasingStyle.Back)
	local ribbon = create("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.66, 0), Size = UDim2.fromOffset(360, 110), BackgroundColor3 = WHITE, ZIndex = 24, Parent = overlayGui }, { corner(UDim.new(0, 22)), stroke(5, INK) })
	gradient(ribbon, rc:Lerp(WHITE, 0.3), rc:Lerp(Color3.new(0, 0, 0), 0.15))
	label({ parent = ribbon, text = P.name, size = 36, sz = UDim2.new(1, 0, 0, 44), pos = UDim2.fromOffset(0, 6), z = 25 })
	label({ parent = ribbon, text = `{string.upper(P.rarity)} · +{math.floor(P.boost * 100 + 0.5)}% coins`, size = 20, sz = UDim2.new(1, 0, 0, 28), pos = UDim2.fromOffset(0, 54), z = 25 })
	local start = os.clock()
	local revealDone = false
	local conn
	conn = RunService.RenderStepped:Connect(function()
		if revealDone then
			conn:Disconnect()
			return
		end
		local pivot = CFrame.Angles(0, math.sin((os.clock() - start) * 1.3) * 0.9, 0) * CFrame.new(0, math.sin((os.clock() - start) * 3) * 0.12, 0)
		model:PivotTo(pivot)
		animatePet(revealAnims, pivot, os.clock() - start, 1)
	end)
	task.wait(3)
	revealDone = true
	conn:Disconnect()
	tween(shade, 0.3, { BackgroundTransparency = 1 })
	tween(vsc, 0.25, { Scale = 0 })
	local rsc = create("UIScale", { Parent = ribbon })
	tween(rsc, 0.25, { Scale = 0 })
	task.wait(0.35)
	shade:Destroy()
	vp:Destroy()
	ribbon:Destroy()
	hatching = false
end)

-- LEVEL UP -----------------------------------------------------------------------
Remotes.LevelUp.OnClientEvent:Connect(function(level, reward)
	local big = label({ parent = overlayGui, text = "LEVEL UP!", size = 64, color = Color3.fromRGB(130, 220, 255), sz = UDim2.fromOffset(600, 80), pos = UDim2.fromScale(0.5, 0.3), anchor = Vector2.new(0.5, 0.5), z = 40 })
	local sub = label({ parent = overlayGui, text = `Level {level} · +1% ore value · + 💰 {fmt(reward)}`, size = 26, color = GOLD, sz = UDim2.fromOffset(600, 36), pos = UDim2.fromScale(0.5, 0.37), anchor = Vector2.new(0.5, 0.5), z = 40 })
	local sc = create("UIScale", { Scale = 0.3, Parent = big })
	tween(sc, 0.4, { Scale = 1 }, Enum.EasingStyle.Back)
	confetti(45)
	playSound("LevelUp", 1)
	task.delay(2.2, function()
		tween(sc, 0.25, { Scale = 0 })
		tween(sub, 0.25, { TextTransparency = 1 })
		task.wait(0.3)
		big:Destroy()
		sub:Destroy()
	end)
end)

-- Slow HUD refresh (level bar, potions, badges, pass buttons) ----------------------
-- OBJECTIVE BANNER + ARROW TRAIL --------------------------------------------------
-- A big "what to do next" banner at the top and red arrows on the ground leading to it.
-- It walks new players through the first steps, then always shows the next goal.
local updateObjective, updateArrows
do
	local banner2 = create("Frame", {
		Name = "Objective",
		AnchorPoint = Vector2.new(0.5, 0),
		Position = UDim2.new(0.5, 0, 0, 10),
		Size = UDim2.fromOffset(0, 58),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.35,
		Parent = gui,
	}, {
		create("UIPadding", { PaddingLeft = UDim.new(0, 60), PaddingRight = UDim.new(0, 60) }),
		create("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.18, 0.25), NumberSequenceKeypoint.new(0.82, 0.25), NumberSequenceKeypoint.new(1, 1) }) }),
	})
	local bannerScale = create("UIScale", { Parent = banner2 })
	local objText = create("TextLabel", {
		Size = UDim2.fromOffset(0, 58),
		AutomaticSize = Enum.AutomaticSize.X,
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 40,
		TextColor3 = WHITE,
		Text = "",
		Parent = banner2,
	}, { stroke(4, INK) })
	local stepLabel = create("TextLabel", {
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 0, 12),
		Size = UDim2.fromOffset(200, 18),
		BackgroundTransparency = 1,
		Font = FONT,
		TextSize = 16,
		TextColor3 = GOLD,
		Text = "",
		Parent = banner2,
	}, { stroke(2.5, INK) })

	local function tagged(tag, pred)
		for _, inst in CollectionService:GetTagged(tag) do
			if not pred or pred(inst) then
				return inst
			end
		end
		return nil
	end
	local function pedestal(kind, tier)
		local p = tagged("ShopItem", function(pr)
			return pr:GetAttribute("Kind") == kind and pr:GetAttribute("Tier") == tier
		end)
		return p and p.Parent
	end
	local function posOf(target)
		if typeof(target) == "Vector3" then
			return target
		elseif typeof(target) == "Instance" and target:IsA("BasePart") then
			return target.Position
		end
		return nil
	end

	local TUTORIAL_STEPS = 9
	local current, currentTarget = "", nil
	-- returns: text, target (part or position), tutorial step number (or nil)
	local function pick(depth)
		local mineCenter = player:GetAttribute("ShaftPos") or Vector3.new(0, CFG.top, 0) -- your own shaft
		local mined, tut, pickTier, pack = attr("Mined", 0), attr("Tut", 0), attr("Pick", 1), attr("Pack", 1)
		local coins, bag, bagMax, best = attr("Coins", 0), attr("Bag", 0), attr("BagMax", 20), attr("Best", 0)
		local have = coins + attr("BagValue", 0)
		local underground = depth > 5
		local full = bag >= bagMax
		local sellPad = tagged("SellPad")
		local function sellStep(step)
			if underground then
				return if isTouch then "⬆ Tap SURFACE to sell!" else "⬆ Press R to go sell!", nil, step
			end
			return "💰 Sell your ores!", sellPad, step
		end
		local function earn(step, goalText, price)
			if full or (bag > 0 and have >= price) then
				return sellStep(step)
			end
			return `⛏ {goalText} ({fmt(have)}/{fmt(price)})`, mineCenter, step
		end
		local strength = attr("Strength", 0)
		if mined < 3 and strength < 25 then
			return `💪 Click to train Strength! ({fmt(strength)}/25)`, nil, 1
		end
		if mined < 3 then
			return "⛏ Jump in YOUR mine and click to break it!", mineCenter, 2
		end
		if tut < 2 then
			if bag >= math.min(10, bagMax) then
				return sellStep(3)
			end
			return `🎒 Fill your backpack! ({bag}/{math.min(10, bagMax)})`, mineCenter, 3
		end
		local p2 = CFG.picks[2]
		if pickTier < 2 then
			if coins >= p2.price then
				return `⛏ Buy the {p2.name}!`, pedestal("Pick", 2), 4
			end
			return earn(4, "Dig coins for a " .. p2.name, p2.price)
		end
		local b2 = CFG.bags[2]
		if pack < 2 then
			if coins >= b2.price then
				return `🎒 Buy the {b2.name}!`, pedestal("Bag", 2), 5
			end
			return earn(5, "Dig coins for a " .. b2.name, b2.price)
		end
		local egg = CFG.eggs[1]
		if attr("PetIndex", 0) == 0 then
			if coins >= egg.price then
				return "🥚 Hatch your first pet!", tagged("EggStand", function(e)
					return e:GetAttribute("Egg") == 1
				end), 6
			end
			return earn(6, "Dig coins for a pet egg", egg.price)
		end
		if best < 20 then
			if full then
				return sellStep(7)
			end
			return `⬇ Dig down to 20m! ({best}m)`, mineCenter, 7
		end
		if strength < 150 and attr("Rebirths", 0) == 0 then
			return `🏋️ Train on the FREE rock! ({fmt(strength)}/150 💪)`, tagged("TrainingRock", function(r)
				return r:GetAttribute("Rock") == 1
			end), 8
		end
		if attr("LastDay", -1) ~= math.floor(workspace:GetServerTimeNow() / 86400) then
			return "🎁 Open your FREE daily chest!", tagged("DailyChest"), 9
		end
		-- after the tutorial: always the next goal
		if strength >= attr("RebirthReq", math.huge) then
			return `🔁 REBIRTH for +{1 + (attr("Rebirths", 0) + 1) * CFG.rebirthStrength} 💪 per click!`, nil, nil
		end
		if full then
			return sellStep(nil)
		end
		local nextPick = CFG.picks[pickTier + 1]
		if nextPick and coins >= nextPick.price then
			return `⛏ Buy the {nextPick.name}!`, pedestal("Pick", pickTier + 1), nil
		end
		local nextBag = CFG.bags[pack + 1]
		if nextBag and coins >= nextBag.price and (not nextPick or nextBag.price <= nextPick.price * 0.5) then
			return `🎒 Buy the {nextBag.name}!`, pedestal("Bag", pack + 1), nil
		end
		if best >= CFG.maxDepth then
			return "⭐ ASCEND at the shrine!", tagged("Shrine"), nil
		end
		for _, L in CFG.layers do
			if L.from > best then
				return `⬇ Reach {L.from}m: {L.name}!`, mineCenter, nil
			end
		end
		return `⬇ Reach {CFG.maxDepth}m to Ascend!`, mineCenter, nil
	end

	updateObjective = function(depth)
		local text, target, step = pick(depth)
		currentTarget = target
		if text ~= current then
			local first = current == ""
			current = text
			objText.Text = text
			stepLabel.Text = if step then `STEP {step} / {TUTORIAL_STEPS}` else ""
			bannerScale.Scale = 0.6
			tween(bannerScale, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
			if not first then
				playSound("Pop", 1.2)
			end
		end
	end

	-- red chevrons that scroll along the ground towards the objective
	local arrowFolder = Instance.new("Folder")
	arrowFolder.Name = "DigArrows"
	arrowFolder.Parent = workspace
	local ARROWS, SPACING = 34, 3.6
	local arrows = {}
	for k = 1, ARROWS do
		local pair = {}
		for side = -1, 1, 2 do
			local bar = Instance.new("Part")
			bar.Anchored = true
			bar.CanCollide = false
			bar.CanQuery = false
			bar.CanTouch = false
			bar.CastShadow = false
			bar.Size = Vector3.new(0.45, 0.2, 1.5)
			bar.Color = Color3.fromRGB(255, 45, 45)
			bar.Material = Enum.Material.SmoothPlastic
			bar.Transparency = 1
			bar.Parent = arrowFolder
			pair[side] = bar
		end
		arrows[k] = pair
	end
	local groundParams = RaycastParams.new()
	groundParams.FilterType = Enum.RaycastFilterType.Exclude
	local function hideFrom(k)
		for i = k, ARROWS do
			arrows[i][-1].Transparency = 1
			arrows[i][1].Transparency = 1
		end
	end
	updateArrows = function(depth)
		local root = getRoot()
		local goal = posOf(currentTarget)
		if not root or not goal then
			hideFrom(1)
			return
		end
		local start = root.Position - Vector3.new(0, 2.8, 0)
		-- underground players get "press surface" instead of arrows through rock
		if depth > 5 and goal.Y > CFG.top - 8 then
			hideFrom(1)
			return
		end
		local flat = Vector3.new(goal.X - start.X, 0, goal.Z - start.Z)
		local dist = flat.Magnitude
		if dist < 6 then
			hideFrom(1)
			return
		end
		local dir = flat.Unit
		groundParams.FilterDescendantsInstances = { arrowFolder, player.Character or arrowFolder }
		local offset = (os.clock() * 5) % SPACING
		local shown = 0
		for k = 1, ARROWS do
			local along = 2.5 + offset + (k - 1) * SPACING
			if along > dist - 3 then
				break
			end
			local p = start + dir * along
			local hit = workspace:Raycast(p + Vector3.new(0, 12, 0), Vector3.new(0, -40, 0), groundParams)
			local y = if hit then hit.Position.Y + 0.25 else start.Y + 0.25
			local base = CFrame.lookAt(Vector3.new(p.X, y, p.Z), Vector3.new(p.X, y, p.Z) + dir)
			for side = -1, 1, 2 do
				local bar = arrows[k][side]
				bar.CFrame = base * CFrame.new(side * 0.45, 0, 0.35) * CFrame.Angles(0, side * math.rad(-40), 0)
				bar.Transparency = if k == 1 then 0.5 else 0
			end
			shown = k
		end
		hideFrom(shown + 1)
	end
end

local function updateSimHUD()
	local now = workspace:GetServerTimeNow()
	local nextPick = CFG.picks[attr("Pick", 1) + 1]
	if nextPick then
		local have = attr("Coins", 0) + attr("BagValue", 0)
		goalFill.Size = UDim2.fromScale(math.clamp(have / nextPick.price, 0, 1), 1)
		goalText.Text = `⛏ Next: {nextPick.name} · {math.floor(math.clamp(have / nextPick.price, 0, 1) * 100)}%`
	else
		goalFill.Size = UDim2.fromScale(math.clamp(attr("Best", 0) / CFG.maxDepth, 0, 1), 1)
		goalText.Text = `⭐ Next: reach {CFG.maxDepth}m to Ascend`
	end
	if windows.Quests_reset then
		windows.Quests_reset()
	end
	local lvl, xp, need = attr("Level", 1), attr("XP", 0), attr("XPNeed", 30)
	levelText.Text = `Lv {lvl}  ·  {fmt(xp)} / {fmt(need)} XP`
	levelFill.Size = UDim2.fromScale(math.clamp(xp / math.max(1, need), 0, 1), 1)
	for _, pdef in POTIONS do
		local left = attr("Potion_" .. pdef.key, 0) - now
		local pill = potionPills[pdef.key]
		pill.Parent.Visible = left > 0
		if left > 0 then
			pill.Text = `{pdef.icon} {clock(left)}`
		end
	end
	local spinReady = now >= attr("SpinAt", 0)
	stackButtons.Spin.Badge.Visible = spinReady
	if spinLabel and not wheelSpinning then
		spinLabel.Text = if spinReady then "SPIN!" else "⏳ " .. clock(attr("SpinAt", 0) - now)
	end
	offerButton.Visible = not attr("Starter", false)
	sellButton.Visible = attr("Pass_SellAnywhere", false) and attr("Bag", 0) > 0
	autoButton.Visible = attr("Pass_AutoMine", false)
end

-- Tell the player when their coins plus the ore in their bag can pay for the next pickaxe.
local announcedTier = attr("Pick", 1)
local function checkAfford()
	local owned = attr("Pick", 1)
	if owned > announcedTier then
		announcedTier = owned
	end
	local nextPick = CFG.picks[owned + 1]
	if nextPick and owned + 1 > announcedTier and attr("Coins", 0) + attr("BagValue", 0) >= nextPick.price and attr("Tut", 0) >= 2 then
		announcedTier = owned + 1
		toast(if attr("Coins", 0) >= nextPick.price
			then `⛏ You can buy the {nextPick.name}!`
			else `⛏ Sell your bag to buy the {nextPick.name}!`, GOLD)
		playSound("Buy", 1.3)
	end
end

--------------------------------------------------------------------------------
-- MAIN LOOP
--------------------------------------------------------------------------------
local slowTimer = 0
local gaugeShown = false

RunService.RenderStepped:Connect(function(dt)
	updateMining()
	updatePets(dt)
	updateArrows(currentDepth())

	local depth = currentDepth()
	local now = workspace:GetServerTimeNow()
	local t = os.clock()

	-- Lighting
	local target = if skyOpen then math.clamp((depth - 6) / 30, 0, 0.35) else math.clamp(depth / 8, 0, 1)
	dark += (target - dark) * (1 - math.exp(-dt * 3))
	Lighting.Ambient = baseAmbient:Lerp(DEEP_AMBIENT, dark)
	if ambienceSounds.Surface then
		ambienceSounds.Surface.Volume = 0.45 * (1 - dark)
		ambienceSounds.Cave.Volume = 0.6 * dark
	end
	musicSound.Volume = 0.35 * (1 - 0.5 * dark)
	Lighting.OutdoorAmbient = baseOutdoor:Lerp(DEEP_OUTDOOR, dark)
	local layer = CFG.layers[layerIndexAt(depth)]
	local tint = WHITE:Lerp(rgb(layer.tint), dark)
	local rush = now % CFG.rushEvery < CFG.rushLength
	if rush then
		tint = tint:Lerp(Color3.fromRGB(255, 226, 150), 0.25)
	end
	grade.TintColor = grade.TintColor:Lerp(tint, 1 - math.exp(-dt * 4))
	grade.Contrast = 0.05 + 0.08 * dark
	grade.Saturation = 0

	-- Camera shake (swings, finds and earthquakes)
	local hum = getHumanoid()
	local quakeAt = workspace:GetAttribute("QuakeAt")
	local quake = 0
	if type(quakeAt) == "number" and quakeAt > now and settings.shake then
		quake = math.clamp(1 - (quakeAt - now) / 20, 0.15, 1) * 0.7
	end
	shake = math.max(0, shake - dt * 2.5)
	local amount = shake + quake
	if hum then
		if amount > 0.001 then
			hum.CameraOffset = Vector3.new(math.random(-100, 100) / 100, math.random(-100, 100) / 100, math.random(-100, 100) / 100) * amount
		elseif hum.CameraOffset ~= Vector3.zero then
			hum.CameraOffset = Vector3.zero
		end
	end

	-- Spinning displays
	for model, s in spinning do
		if model.Parent then
			model:PivotTo(CFrame.new(s.pivot.Position + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.3, 0)) * CFrame.Angles(0, t * 0.9 + s.phase, 0) * s.pivot.Rotation)
		end
	end

	-- Depth gauge + surface button
	local underground = depth > 5 or (depth > 0 and not skyOpen)
	if underground ~= gaugeShown then
		gaugeShown = underground
		gauge.Visible = underground
		surfaceButton.Visible = underground
	end
	if underground then
		marker.Position = UDim2.fromScale(0.5, math.clamp(depth / CFG.maxDepth, 0, 1))
		bestTick.Position = UDim2.fromScale(0.5, math.clamp(attr("Best", 0) / CFG.maxDepth, 0, 1))
		depthLabel.Text = depth .. "m"
		layerLabel.Text = layer.name
	end

	-- Slower updates
	slowTimer += dt
	if slowTimer >= 0.25 then
		slowTimer = 0
		if type(quakeAt) == "number" and quakeAt > now then
			eventLabel.Text = `⚠ EARTHQUAKE IN {math.ceil(quakeAt - now)}s`
			eventLabel.TextColor3 = RED
		elseif rush then
			eventLabel.Text = `✨ GOLD RUSH · {clock(CFG.rushLength - now % CFG.rushEvery)}`
			eventLabel.TextColor3 = if math.floor(t * 3) % 2 == 0 then GOLD else WHITE
		else
			eventLabel.Text = `Gold Rush in {clock(CFG.rushEvery - now % CFG.rushEvery)}`
			eventLabel.TextColor3 = Color3.fromRGB(225, 225, 232)
		end
		checkSky()
		checkAfford()
		updateSimHUD()
		updateObjective(depth)
		refreshStations()
		updateTutorial(depth)
	end
end)

refreshShops()
refreshMuseum()
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="6">
    <Properties>
      <string name="Name">Workspace</string>
      <float name="FallenPartsDestroyHeight">-4000</float>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
  </Item>
</roblox>