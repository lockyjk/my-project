{
  "name": "RollBrainrotMonsterArena",
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "Modules": {
        "$path": "src/shared"
      }
    },
    "ServerScriptService": {
      "Server": {
        "$path": "src/server"
      }
    },
    "ServerStorage": {
      "Tests": {
        "$path": "tests"
      }
    },
    "StarterPlayer": {
      "StarterPlayerScripts": {
        "Client": {
          "$path": "src/client"
        }
      },
      "$properties": {
        "CharacterWalkSpeed": 24,
        "CharacterJumpPower": 50
      }
    },
    "Workspace": {
      "$properties": {
        "StreamingEnabled": true,
        "StreamingMinRadius": 256,
        "StreamingTargetRadius": 1024,
        "FallenPartsDestroyHeight": -200,
        "Gravity": 196.2
      }
    },
    "Lighting": {
      "$properties": {
        "ClockTime": 14.5,
        "Brightness": 2.6,
        "GlobalShadows": true,
        "Technology": "Future"
      }
    },
    "SoundService": {
      "$properties": {
        "RespectFilteringEnabled": true
      }
    }
  }
}
